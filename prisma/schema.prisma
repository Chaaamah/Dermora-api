// Dermora — dermora_db
// Schéma `app`  : comptes, catalogue, contenus, partenaires, audit
// Schéma `care` : données de peau / cheveux (rôle restreint en production)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
  schemas   = ["app", "care"]
}

enum Role {
  CLIENT
  DERMATOLOGIST
  EXPERT
  ADMIN

  @@schema("app")
}

// ───────────────────────────── app ─────────────────────────────

model User {
  id              String    @id @default(cuid())
  email           String?   @unique
  passwordHash    String?
  phone           String?   @unique
  role            Role      @default(CLIENT)
  resetCodeHash   String?
  resetExpiresAt  DateTime?
  resetAttempts   Int       @default(0)
  /// Activation par e-mail : un lien en attente (hash) bloque la connexion tant qu'il n'est pas utilisé.
  /// Les comptes créés avant cette fonctionnalité n'ont pas de lien en attente : ils restent actifs.
  verifyTokenHash String?
  verifyExpiresAt DateTime?
  emailVerifiedAt DateTime?
  firstName       String?
  lang            String    @default("fr")
  city            String?
  birthDate       DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  consents             Consent[]
  skinProfile          SkinProfile?
  hairProfile          HairProfile?
  scans                Scan[]
  routines             Routine[]
  checks               RoutineCheck[]
  notes                SkinNote[]
  favorites            Favorite[]
  dermatologist        Dermatologist?
  careLinks            CareLink[]            @relation("PatientLinks")
  messages             Message[]             @relation("PatientMessages")
  clinicalNotes        ClinicalNote[]        @relation("PatientClinicalNotes")
  notifications        Notification[]
  reminderSettings     ReminderSettings?
  reminderLogs         ReminderLog[]
  pushTokens           PushToken[]
  productChecks        ProductCheck[]
  personalizedRoutines PersonalizedRoutine[]
  sharedRoutines       SharedRoutine[]

  @@index([verifyTokenHash])
  @@schema("app")
}

/// Jetons Firebase Cloud Messaging (web et mobile) pour les notifications push.
model PushToken {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  platform  String // web | android | ios
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@schema("app")
}

/// Rappels de routine : une notification par étape, heure locale du Maroc.
model ReminderSettings {
  id         String   @id @default(cuid())
  userId     String   @unique
  enabled    Boolean  @default(true)
  amTime     String   @default("08:00")
  pmTime     String   @default("21:30")
  hairTime   String   @default("19:00")
  hairDays   Int[]    @default([3, 6]) // 1 = lundi … 7 = dimanche
  stepGapMin Int      @default(3) // minutes entre deux étapes
  updatedAt  DateTime @updatedAt
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@schema("app")
}

model Notification {
  id        String    @id @default(cuid())
  userId    String
  type      String // message | care_request | care_accepted | care_declined | recommendation | routine | system
  title     String
  body      String
  link      String?
  readAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
  @@schema("app")
}

/// Emplacements publicitaires — toujours signalés « Publicité » (loi 31-08, RG-10).
model Ad {
  id          String   @id @default(cuid())
  placement   String // home_banner | discovery_inline | guide_inline
  advertiser  String
  title       String
  body        String
  cta         String
  url         String
  tone        String   @default("rose") // rose | gold | night
  active      Boolean  @default(true)
  impressions Int      @default(0)
  clicks      Int      @default(0)
  createdAt   DateTime @default(now())

  @@schema("app")
}

model OtpCode {
  id        String    @id @default(cuid())
  phone     String
  codeHash  String
  channel   String    @default("sms")
  attempts  Int       @default(0)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([phone])
  @@schema("app")
}

model Consent {
  id        String    @id @default(cuid())
  userId    String
  type      String // photos | skin_data | model_improvement | marketing | care_sharing
  version   String    @default("1.0")
  granted   Boolean
  createdAt DateTime  @default(now())
  revokedAt DateTime?
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
  @@schema("app")
}

model Ingredient {
  id              String              @id @default(cuid())
  inci            String              @unique
  nameFr          String
  function        String
  pregnancyUnsafe Boolean             @default(false)
  irritant        Boolean             @default(false)
  banned          Boolean             @default(false)
  precautions     String?
  regulatory      String              @default("autorisé")
  products        ProductIngredient[]

  @@schema("app")
}

model Product {
  id           String              @id @default(cuid())
  brand        String
  name         String
  domain       String              @default("skin") // skin | hair
  category     String // cleanser | serum | moisturizer | sunscreen | treatment | shampoo | conditioner | hair_mask | hair_oil
  sizeMl       Int?
  monthsSupply Float               @default(2)
  skinTypes    String[] // seche | grasse | mixte | normale | all ; hair: boucle types | all
  concerns     String[] // acne | taches | rides | pores | secheresse | rougeurs | eclat | chute | frisottis | pellicules
  avoidFor     String[] // pregnancy | sensitive
  description  String
  howTo        String
  precautions  String?
  isNatural    Boolean             @default(false)
  origin       String? // pays d'origine de la marque, ex. KR (soins coréens)
  sponsored    Boolean             @default(false)
  imageUrl     String?
  imageSource  String? // marchand d'où provient la photo
  sourceKey    String?             @unique // identifiant du catalogue importé
  status       String              @default("ACTIVE") // ACTIVE | WITHDRAWN
  validatedBy  String?
  validatedAt  DateTime?
  createdAt    DateTime            @default(now())
  ingredients  ProductIngredient[]
  offers       Offer[]
  favorites    Favorite[]

  @@schema("app")
}

model ProductIngredient {
  productId    String
  ingredientId String
  key          Boolean    @default(false)
  product      Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  ingredient   Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Cascade)

  @@id([productId, ingredientId])
  @@schema("app")
}

model Merchant {
  id       String  @id @default(cuid())
  name     String
  type     String // ONLINE | STORE
  city     String?
  website  String?
  verified Boolean @default(true)
  partner  Boolean @default(false) // contrat d'affiliation signé
  platform String? // woocommerce
  apiBase  String?
  offers   Offer[]

  @@schema("app")
}

model Offer {
  id         String   @id @default(cuid())
  productId  String
  merchantId String
  priceMad   Float
  regularMad Float?
  externalId String? // identifiant du produit chez le marchand (relevé automatique des prix)
  inStock    Boolean  @default(true)
  url        String
  updatedAt  DateTime @default(now())
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  merchant   Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)

  @@schema("app")
}

model Ritual {
  id          String    @id @default(cuid())
  slug        String    @unique
  name        String
  ingredient  String
  forDomain   String // skin | hair
  benefits    String
  howTo       String
  precautions String[]
  avoidFor    String[]
  category    String    @default("visage") // visage | corps | cheveux | hammam
  steps       String[]
  durationMin Int       @default(15)
  frequency   String    @default("")
  skinTypes   String[]
  concerns    String[]
  origin      String?
  validatedBy String?
  validatedAt DateTime?

  @@schema("app")
}

model Article {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  summary     String
  body        String
  readMinutes Int      @default(3)
  tag         String
  validatedBy String?
  createdAt   DateTime @default(now())

  @@schema("app")
}

model RoutineRule {
  id         String  @id @default(cuid())
  domain     String  @default("skin")
  moment     String // AM | PM | HAIR
  order      Int
  step       String // nettoyant, sérum ciblé…
  category   String
  optional   Boolean @default(false)
  frequency  String  @default("chaque jour")
  quantity   String?
  introWeek  Int     @default(1)
  conditions Json? // { concerns?: string[] }
  validated  Boolean @default(true)

  @@schema("app")
}

model ClickEvent {
  id         String   @id @default(cuid())
  productId  String
  merchantId String
  userId     String?
  createdAt  DateTime @default(now())

  @@schema("app")
}

model Favorite {
  userId    String
  productId String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([userId, productId])
  @@schema("app")
}

model Dermatologist {
  id           String                    @id @default(cuid())
  userId       String                    @unique
  fullName     String
  title        String                    @default("Dermatologue")
  ordreNumber  String
  verified     Boolean                   @default(false)
  city         String
  bio          String?
  languages    String[]
  priceMad     Int                       @default(300)
  user         User                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  links        CareLink[]
  offerings    DermatologistOffering[]
  technologies DermatologistTechnology[]

  @@schema("app")
}

model DermatologistOffering {
  id              String        @id @default(cuid())
  dermatologistId String
  category        String // face | hair
  title           String
  description     String?
  createdAt       DateTime      @default(now())
  dermatologist   Dermatologist @relation(fields: [dermatologistId], references: [id], onDelete: Cascade)

  @@index([dermatologistId, category])
  @@schema("app")
}

model DermatologistTechnology {
  id              String        @id @default(cuid())
  dermatologistId String
  name            String
  description     String?
  createdAt       DateTime      @default(now())
  dermatologist   Dermatologist @relation(fields: [dermatologistId], references: [id], onDelete: Cascade)

  @@index([dermatologistId])
  @@schema("app")
}

model Report {
  id        String   @id @default(cuid())
  userId    String?
  kind      String // counterfeit | reaction | wrong_price | other
  productId String?
  message   String
  status    String   @default("OPEN")
  createdAt DateTime @default(now())

  @@schema("app")
}

model AuditLog {
  id        String   @id @default(cuid())
  actorId   String
  action    String
  object    String
  createdAt DateTime @default(now())

  @@schema("app")
}

// ───────────────────────────── care ─────────────────────────────

model SkinProfile {
  id               String   @id @default(cuid())
  userId           String   @unique
  skinType         String // seche | grasse | mixte | normale
  sensitive        Boolean  @default(false)
  phototype        Int      @default(3)
  concerns         String[]
  pregnant         Boolean  @default(false)
  breastfeeding    Boolean  @default(false)
  allergies        String[]
  currentProducts  String?
  moleChanging     Boolean  @default(false)
  lesionNotHealing Boolean  @default(false)
  painfulRash      Boolean  @default(false)
  updatedAt        DateTime @updatedAt
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@schema("care")
}

model HairProfile {
  id             String   @id @default(cuid())
  userId         String   @unique
  curlType       String // lisse | ondule | boucle | crepu
  porosity       String // faible | moyenne | forte
  scalp          String // normal | gras | sec | pellicules
  hairLoss       String   @default("non") // non | legere | importante
  suddenHairLoss Boolean  @default(false)
  colored        Boolean  @default(false)
  washPerWeek    Int      @default(2)
  updatedAt      DateTime @updatedAt
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@schema("care")
}

model Scan {
  id        String   @id @default(cuid())
  userId    String
  type      String   @default("skin")
  provider  String
  costMad   Float    @default(0)
  results   Json // { zones: {...}, concerns: {...} }
  summary   String[]
  photoKept Boolean  @default(false)
  photoRef  String?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@schema("care")
}

model Routine {
  id                    String        @id @default(cuid())
  userId                String
  budgetMad             Int
  tier                  String? // eco | equilibre | premium | budget | personnalisee
  personalizedRoutineId String?
  totalMad              Float         @default(0)
  active                Boolean       @default(true)
  blocked               Boolean       @default(false)
  blockReason           String?
  notes                 String[]
  createdAt             DateTime      @default(now())
  user                  User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  steps                 RoutineStep[]

  @@schema("care")
}

model RoutineStep {
  id            String  @id @default(cuid())
  routineId     String
  moment        String // AM | PM | HAIR
  order         Int
  step          String
  category      String
  productId     String?
  customProduct Json?
  monthlyMad    Float   @default(0)
  frequency     String
  quantity      String?
  introWeek     Int     @default(1)
  alternatives  Json? // { cheaper?: productId, natural?: ritualSlug }
  routine       Routine @relation(fields: [routineId], references: [id], onDelete: Cascade)

  @@schema("care")
}

model RoutineCheck {
  id        String   @id @default(cuid())
  userId    String
  day       String // YYYY-MM-DD
  stepId    String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, day, stepId])
  @@schema("care")
}

model SkinNote {
  id        String   @id @default(cuid())
  userId    String
  kind      String // reaction | irritation | amelioration | note
  text      String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@schema("care")
}

model CareLink {
  id              String        @id @default(cuid())
  patientId       String
  dermatologistId String
  status          String        @default("PENDING") // PENDING | ACTIVE | ENDED
  reason          String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  patient         User          @relation("PatientLinks", fields: [patientId], references: [id], onDelete: Cascade)
  dermatologist   Dermatologist @relation(fields: [dermatologistId], references: [id], onDelete: Cascade)

  @@index([patientId])
  @@index([dermatologistId])
  @@schema("care")
}

model ClinicalNote {
  id              String   @id @default(cuid())
  patientId       String
  dermatologistId String
  text            String
  recommendation  String?
  createdAt       DateTime @default(now())
  patient         User     @relation("PatientClinicalNotes", fields: [patientId], references: [id], onDelete: Cascade)

  @@schema("care")
}

model Message {
  id             String    @id @default(cuid())
  patientId      String
  channel        String // AI | CARE
  senderRole     String // PATIENT | DERMATOLOGIST | ASSISTANT
  senderId       String?
  content        String
  kind           String    @default("text") // text | image | scan | routine
  refId          String? // id de l'analyse partagée
  attachment     Bytes? // photo jointe (chiffrée au repos en production)
  attachmentType String?
  readAt         DateTime?
  createdAt      DateTime  @default(now())
  patient        User      @relation("PatientMessages", fields: [patientId], references: [id], onDelete: Cascade)

  @@index([patientId, channel, createdAt])
  @@schema("care")
}

model ReminderLog {
  id        String   @id @default(cuid())
  userId    String
  day       String // YYYY-MM-DD (heure du Maroc)
  stepId    String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, day, stepId])
  @@schema("care")
}

/// « Mes produits » : produits que l'utilisatrice utilise déjà, analysés selon son profil
model ProductCheck {
  id              String   @id @default(cuid())
  userId          String
  barcode         String?
  productId       String?
  brand           String?
  name            String
  category        String
  imageUrl        String?
  ingredientsText String?
  source          String   @default("manual") // barcode | photo | catalog | manual
  verdict         String // adapte | surveiller | deconseille | inconnu
  result          Json
  createdAt       DateTime @default(now())
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@schema("care")
}

model PersonalizedRoutine {
  id        String         @id @default(cuid())
  userId    String
  concerns  String[]
  steps     Json
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  shared    SharedRoutine?

  @@index([userId, createdAt])
  @@schema("care")
}

model SharedRoutine {
  id                    String              @id @default(cuid())
  userId                String
  personalizedRoutineId String              @unique
  concerns              String[]
  steps                 Json
  consentAt             DateTime
  status                String              @default("PENDING") // PENDING | APPROVED | REJECTED
  moderationNote        String?
  moderatedAt           DateTime?
  publishedAt           DateTime?
  createdAt             DateTime            @default(now())
  user                  User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  personalizedRoutine   PersonalizedRoutine @relation(fields: [personalizedRoutineId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
  @@index([userId, createdAt])
  @@schema("care")
}
