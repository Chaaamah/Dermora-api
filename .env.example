DATABASE_URL="postgresql://dermora:dermora@localhost:5434/dermora_db?schema=app"
DIRECT_URL="postgresql://dermora:dermora@localhost:5434/dermora_db?schema=app"
PORT=4000
CORS_ORIGINS="http://localhost:3100,http://localhost:3200"
# Generate separate secrets (at least 32 random bytes each), for example:
# node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
# E-mails (réinitialisation du mot de passe). Sans SMTP_HOST, le code est affiché en développement.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Dermora <no-reply@dermora.ma>"
# Assistante IA (Claude) — clé sur https://console.anthropic.com > API Keys. Sans clé, une assistante de secours à règles répond.
# (L'analyse de peau n'utilise aucune clé : elle est faite sur l'appareil, la photo n'est jamais envoyée.)
ANTHROPIC_API_KEY=
ASSISTANT_MODEL=claude-opus-5-5

# Production : ne publier que les produits / contenus validés par le pharmacien conseil
REQUIRE_EXPERT_VALIDATION=false
# Relevé automatique des prix chez les marchands (heures, 0 = désactivé)
PRICE_SYNC_HOURS=24
PUBLIC_WEB_URL=http://localhost:3100

# Rappels de routine : minuteur interne (minutes, 0 = uniquement via la tâche cron)
REMINDERS_INTERVAL_MIN=5
# Secret des tâches planifiées : POST /v1/cron/reminders et /v1/cron/prices avec l'en-tête x-cron-secret
CRON_SECRET=
# Notifications push (Firebase Cloud Messaging) : JSON du compte de service, brut ou en base64
FIREBASE_SERVICE_ACCOUNT=
# Firebase project ID used to verify Google/Facebook sign-in tokens
FIREBASE_PROJECT_ID=
FREE_SCANS_PER_MONTH=10

# Super administrateur : créé au démarrage s'il n'existe pas (le mot de passe ne sert qu'à la création)
ADMIN_EMAIL=
ADMIN_PASSWORD=
# E-mails : API Brevo (prioritaire sur le SMTP). Clé dans Brevo > SMTP & API > Clés API
BREVO_API_KEY=

# Assistante IA gratuite (compatible OpenAI) si Claude est indisponible : Groq (console.groq.com) ou Google Gemini
AI_API_KEY=
AI_BASE_URL=https://api.groq.com/openai/v1
AI_MODEL=llama-3.3-70b-versatile
